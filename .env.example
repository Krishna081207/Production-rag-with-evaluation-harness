# Start with Qdrant. Use a remote Qdrant URL for multi-replica deployments.
VECTOR_DB=qdrant
QDRANT_URL=
QDRANT_PATH=rag_hybrid/data/qdrant
QDRANT_COLLECTION_NAME=rag-hybrid
RAG_DATA_DIR=rag_hybrid/data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation is optional; without a key, the app returns a cited extractive answer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required to upload documents through the API. Set a long random value.
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760

# Pinecone is optional. Install with: python -m pip install -e ".[pinecone]"
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-hybrid
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

RAG_API_URL=http://localhost:8000
