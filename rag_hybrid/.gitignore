# ==============================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# Testing, coverage, and linting caches
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.ruff_cache/
eval_output.txt

# ==============================================================================
# Local data, vector DB caches, and embedding stores
# ==============================================================================
chunks/
embeddings/
qdrant_storage/
local_vector_db/
documentation/

# Local ingested raw documents (keep sample or .gitkeep)
data/*
!data/.gitkeep
!data/sample.txt

